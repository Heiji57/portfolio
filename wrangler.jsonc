// Static-assets Worker. Without this file `wrangler deploy` auto-configures the Vite project
// and rebuilds it with the Cloudflare plugin, which breaks the SSR prerender step.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
